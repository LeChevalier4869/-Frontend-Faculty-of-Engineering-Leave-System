# URL ของ backend — Vite ฝังค่านี้เข้า bundle "ตอน build" (ไม่ใช่ตอน runtime)
#
# - เปิดผ่าน localhost: ไม่ต้องตั้งก็ได้ (โค้ด default เป็น http://localhost:8000)
# - ขึ้น server จริงที่เข้าผ่านโดเมน: ต้องตั้งค่านี้ให้ชี้ backend จริง
#   แล้ว build ใหม่ เช่น  docker build --build-arg VITE_BACKEND_URL=https://api.example.ac.th ...
VITE_BACKEND_URL=https://api.example.ac.th
